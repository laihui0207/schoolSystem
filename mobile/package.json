{
  "name": "school-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "学生成绩管理系统 — 学生/家长移动端（uni-app Vue3 + Vite + TypeScript）",
  "scripts": {
    "dev:h5": "uni",
    "build:h5": "uni build",
    "dev:mp-weixin": "uni -p mp-weixin",
