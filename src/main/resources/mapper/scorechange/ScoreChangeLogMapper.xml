<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.school.module.scorechange.mapper.ScoreChangeLogMapper">

    <!-- 分页查询变更日志列表 -->
    <select id="selectPageByQuery" resultType="com.school.module.scorechange.entity.ScoreChangeLog">
        SELECT
            id,
            score_id,
            exam_id,
            student_id,
            subject_id,
            old_score,
            new_score,
            change_reason,
            applicant_id,
            approver_id,
            status,
            apply_time,
            approve_time,
            reject_reason,
            created_at,
            updated_at
        FROM score_change_log
        WHERE deleted = 0
        <if test="request.examId != null">
            AND exam_id = #{request.examId}
        </if>
        <if test="request.studentId != null">
            AND student_id = #{request.studentId}
        </if>
        <if test="request.applicantId != null">
            AND applicant_id = #{request.applicantId}
        </if>
        <if test="request.status != null">
            AND status = #{request.status}
        </if>
        <if test="request.orderBy != null and request.orderBy != ''">
            ORDER BY ${request.orderBy}
            <if test="request.isAsc != null and request.isAsc">
                ASC
            </if>
            <if test="request.isAsc == null or !request.isAsc">
                DESC
            </if>
        </if>
        <if test="request.orderBy == null or request.orderBy == ''">
            ORDER BY apply_time DESC
        </if>
    </select>

</mapper>
