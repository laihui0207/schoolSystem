<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.school.module.scorechange.mapper.ScoreChangeLogMapper">

    <!-- 分页查询变更日志列表 -->
    <select id="selectPageByQuery" resultType="com.school.module.scorechange.entity.ScoreChangeLog">
        SELECT
            id,
            score_id,
            exam_id,
            student_id,
            subject_id,
            old_score,
            new_score,
            change_reason,
            applicant_id,
            approver_id,
            status,
            apply_time,
            approve_time,
            reject_reason,
            created_at,
            updated_at
        FROM score_change_log l
        WHERE deleted = 0
        <if test="request.examId != null">
            AND exam_id = #{request.examId}
        </if>
        <if test="request.studentId != null">
            AND student_id = #{request.studentId}
        </if>
        <if test="request.applicantId != null">
            AND applicant_id = #{request.applicantId}
        </if>
        <if test="request.status != null">
            AND status = #{request.status}
        </if>
        <!-- ponytail: score_change_log 没有 school_id/class_id 列，也不在租户白名单，
             校管理员经 exam.school_id、教师经 score.class_id 关联收窄；
             classIds 为空集合时故意让 IN () 报错而不是放开全表（Service 已在空集时短路返回） -->
        <if test="request.schoolId != null">
            AND EXISTS (SELECT 1 FROM exam e WHERE e.id = l.exam_id AND e.school_id = #{request.schoolId})
        </if>
        <if test="request.classIds != null">
            AND EXISTS (
                SELECT 1 FROM score s
                WHERE s.id = l.score_id
                AND s.class_id IN
                <foreach collection="request.classIds" item="classId" open="(" separator="," close=")">
                    #{classId}
                </foreach>
            )
        </if>
        <if test="request.orderBy != null and request.orderBy != ''">
            ORDER BY ${request.orderBy}
            <if test="request.isAsc != null and request.isAsc">
                ASC
            </if>
            <if test="request.isAsc == null or !request.isAsc">
                DESC
            </if>
        </if>
        <if test="request.orderBy == null or request.orderBy == ''">
            ORDER BY apply_time DESC
        </if>
    </select>

</mapper>
